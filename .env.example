# Modèle de .env : copier en .env puis remplacer les valeurs « change_me ».
# Ne jamais enregistrer le vrai .env dans Git ni le partager.

POSTGRES_DB=fox
POSTGRES_USER=fox
POSTGRES_PASSWORD=change_me

# --- IA : Gemini (principal) ---
GEMINI_API_KEY=change_me
# Nom exact du modèle disponible sur ton compte (vérifier : python check_models.py)
GEMINI_MODEL=gemini-3.5-flash-lite
# Second modèle Gemini tenté au premier tour si le principal reste indisponible (optionnel)
GEMINI_FALLBACK_MODEL=

# --- IA : Groq (secours gratuit, conversation seule, sans outils) ---
# Clé à créer sur console.groq.com (laisser vide pour désactiver le secours).
GROQ_API_KEY=
# Les modèles Groq changent : vérifier avec python check_models.py.
# llama-3.3-70b-versatile et llama-3.1-8b-instant ont été retirés en août 2026.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_HISTORY_LIMIT=4

# --- Tentatives automatiques en cas d'erreur temporaire de Gemini (429, 500, 502, 503, 504) ---
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BUDGET_SECONDS=40
LLM_BACKOFF_BASE=1.0
LLM_TIMEOUT_SECONDS=20

# --- Contexte et plafonds ---
HISTORY_LIMIT=10
HISTORY_MAX_CHARS=1200
MAX_CALLS_PER_DAY=200
# Plafond global par jour (UTC). Le quota gratuit Groq est d'environ 200 000 tokens par jour
# pour tout le compte : le dépasser ne sert à rien tant que Groq est le secours.
MAX_TOKENS_PER_DAY=500000

TIMEZONE=Africa/Douala
PENDING_TTL_MINUTES=10
UNDO_WINDOW_MINUTES=60

# --- Telegram ---
TELEGRAM_TOKEN=change_me
TELEGRAM_ALLOWED_USER_ID=0

# --- Comptes et sécurité (phase A) ---
# Jeton secret partagé entre le bot Telegram et l'orchestrateur (obligatoire). Le générer :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FOX_SERVICE_TOKEN=change_me
# Compte propriétaire, créé au démarrage à partir de TELEGRAM_ALLOWED_USER_ID.
OWNER_USERNAME=owner
# Facultatif : mot de passe pour la connexion web du propriétaire (10 caractères minimum).
# Appliqué seulement si le compte n'a pas encore de mot de passe.
OWNER_PASSWORD=
SESSION_DAYS=7
# Mettre 1 derrière HTTPS (VPS) pour que le cookie de session ne circule qu'en HTTPS.
COOKIE_SECURE=0

# --- Quotas par utilisateur et par jour (UTC) ---
OWNER_MAX_CALLS_PER_DAY=200
OWNER_MAX_TOKENS_PER_DAY=500000
TESTER_MAX_CALLS_PER_DAY=30
TESTER_MAX_TOKENS_PER_DAY=15000
# --- Historique et vie privée ---
# Conversations inactives supprimées après N jours (0 = jamais).
RETENTION_DAYS_OWNER=90
RETENTION_DAYS_TESTER=30
# Durée du contexte gardé en mémoire en mode « ne pas enregistrer » (/prive).
PRIVATE_CONTEXT_MINUTES=30

# --- Mise en forme des réponses ---
# 1 = FOX nettoie les réponses (LaTeX -> notation lisible, espaces). 0 = désactivé.
FORMAT_REPLIES=1

# --- Tâches ---
# Nombre maximal de tâches ouvertes par utilisateur (0 = illimité).
MAX_OPEN_TASKS=50
# Les tâches terminées ou annulées sont supprimées après N jours (0 = jamais).
TASK_RETENTION_DAYS=90
# Nombre maximal d'éléments de mémoire par utilisateur.
MAX_MEMORIES=30
# Fréquence (secondes) à laquelle le bot vérifie les rappels dus.
REMINDER_POLL_SECONDS=30

# Plafonds Groq pour TOUS les utilisateurs, sous le quota gratuit du compte.
GROQ_MAX_CALLS_PER_DAY=900
GROQ_MAX_TOKENS_PER_DAY=180000

# --- Google Calendar (laisser vide pour désactiver les outils d'agenda) ---
# Obtenus avec scripts/get_google_token.py. Réservés au propriétaire.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
